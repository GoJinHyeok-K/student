{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew test *)",
      "Bash(./gradlew check *)",
      "Bash(./gradlew spotlessApply *)",
      "Bash(./gradlew spotlessCheck *)",
      "Bash(./gradlew build *)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run build *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "PowerShell(.\\gradlew test *)",
      "PowerShell(.\\gradlew check *)",
      "PowerShell(.\\gradlew spotlessApply *)",
      "PowerShell(.\\gradlew spotlessCheck *)",
      "PowerShell(.\\gradlew build *)",
      "PowerShell(npm test *)",
      "PowerShell(npm run test *)",
      "PowerShell(npm run typecheck *)",
      "PowerShell(npm run build *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npm install *)",
      "Bash(docker *)",
      "Bash(psql *)",
      "PowerShell(git push *)",
      "PowerShell(npm install *)",
      "PowerShell(docker *)",
      "PowerShell(psql *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(./.env.*)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Edit(./.env)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(!**/.env.example)",
      "Read(~/.ssh/**)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main*)",
      "Bash(docker compose down -v*)",
      "Bash(docker volume rm *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * main)",
      "PowerShell(git push * HEAD:main*)",
      "PowerShell(docker compose down -v*)",
      "PowerShell(docker volume rm *)"
    ]
  }
}
