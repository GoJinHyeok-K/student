# 로컬 개발용 환경 변수 예시 / 실제 값은 .env에 쓰고 커밋하지 않는다

# 실행 프로필 (dev, test, prod)
SPRING_PROFILES_ACTIVE=

# 개발 DB (예: jdbc:postgresql://localhost:5432/eduhub)
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# 테스트 DB. 개발 DB와 다른 DB를 쓴다 (예: jdbc:postgresql://localhost:5432/eduhub_test)
TEST_DB_URL=
TEST_DB_USERNAME=
TEST_DB_PASSWORD=
